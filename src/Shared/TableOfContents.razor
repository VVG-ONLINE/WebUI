@using System.Text.RegularExpressions
@using System.Text
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

@* ── TABLE OF CONTENTS — auto-generated from h2/h3 tags in the HTML content ── *@
<div class="toc-container" id="tableOfContents">
    @if (headings != null && headings.Any())
    {
        <nav class="toc-nav" role="navigation" aria-label="Table of Contents">
            <div class="card-header">
                <i class="bi bi-list"></i> ON THIS PAGE
            </div>
            <ul class="card-body toc-list px-3">
                @* Each heading becomes a list item, indented by level (h2 = level-2, h3 = level-3) *@
                @foreach (var heading in headings)
                {
                    <li class="toc-item level-@heading.Level">
                        <span href="@GetHeadingUrl(heading.Id)" class="">
                            @heading.Text
                        </span>
                    </li>
                }
            </ul>

            <div class="toc-actions mt-3 pt-3 border-top border-secondary">
                <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ScrollToTop"
                        title="Scroll to top of page">
                    <i class="bi bi-arrow-up"></i> RETURN TO TOP
                </button>
            </div>
        </nav>
    }
</div>

@code {
    /// <summary>HTML content from which to extract h2 and h3 headings.</summary>
    [Parameter]
    public string? HtmlContent { get; set; }

    /// <summary>All extracted headings, sorted by their position in the document.</summary>
    private List<HeadingInfo>? headings;

    /// <summary>
    /// Runs whenever the HtmlContent parameter changes.
    /// Parses the HTML to find every h2 and h3 tag.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(HtmlContent))
        {
            ExtractHeadings();
        }
    }

    /// <summary>
    /// Uses regex to find all h2 and h3 tags, strips any inner HTML from
    /// the heading text, sorts them by document position, and generates
    /// unique anchor IDs for each heading.
    /// </summary>
    private void ExtractHeadings()
    {
        headings = new List<HeadingInfo>();
        try
        {
            if (string.IsNullOrEmpty(HtmlContent)) return;

            // Regex patterns: match opening tag, capture inner text, closing tag
            // (.*?) = non-greedy capture of everything between <h2> and </h2>
            var h2Pattern = @"<h2[^>]*>(.*?)</h2>";
            var h3Pattern = @"<h3[^>]*>(.*?)</h3>";

            var h2Matches = Regex.Matches(HtmlContent, h2Pattern, RegexOptions.IgnoreCase);
            var h3Matches = Regex.Matches(HtmlContent, h3Pattern, RegexOptions.IgnoreCase);

            // Combine all matches so we can sort by document position
            var allMatches = new List<(int level, string text, int position)>();

            foreach (Match match in h2Matches)
            {
                var text = StripHtmlTags(match.Groups[1].Value).Trim();
                if (!string.IsNullOrEmpty(text))
                    allMatches.Add((2, text, match.Index));
            }

            foreach (Match match in h3Matches)
            {
                var text = StripHtmlTags(match.Groups[1].Value).Trim();
                if (!string.IsNullOrEmpty(text))
                    allMatches.Add((3, text, match.Index));
            }

            // Sort by position in the HTML so headings appear in document order
            allMatches = allMatches.OrderBy(m => m.position).ToList();

            // Generate unique IDs: "heading-0-introduction", "heading-1-getting-started", etc.
            int headingIndex = 0;
            foreach (var (level, text, _) in allMatches)
            {
                var id = GenerateHeadingId(text, headingIndex);
                headings.Add(new HeadingInfo { Level = level, Text = text, Id = id });
                headingIndex++;
            }
        }
        catch (Exception ex)
        {
            // Don't crash the page — just log and show nothing
            Console.Error.WriteLine($"Error extracting headings: {ex.Message}");
        }
    }

    /// <summary>
    /// Builds a full URL with the current page's path and a heading anchor.
    /// Example: /blog/my-post#heading-3-key-section
    /// </summary>
    private string GetHeadingUrl(string? headingId)
    {
        if (string.IsNullOrEmpty(headingId)) return "#";
        try
        {
            var uri = NavigationManager.Uri;
            var baseUri = NavigationManager.BaseUri;

            // Strip the base URL and any existing fragment to get the clean path
            var currentPath = uri.Replace(baseUri, "").Split('#')[0];

            return $"{currentPath}#{headingId}";
        }
        catch (Exception)
        {
            return $"#{headingId}";
        }
    }

    /// <summary>Removes all HTML tags from a string, keeping only the text content.</summary>
    private string StripHtmlTags(string html) =>
        Regex.Replace(html, "<[^>]+>", string.Empty);

    /// <summary>
    /// Creates a URL-safe heading ID from text.
    /// Example: "My Section!" → "heading-0-my-section"
    /// </summary>
    private string GenerateHeadingId(string text, int index)
    {
        // Normalise accented characters (e.g., é → e)
        string normalized = text.Normalize(NormalizationForm.FormD);

        // Remove all non-word characters, replace spaces with hyphens,
        // collapse multiple hyphens, and trim trailing hyphens
        var slug = Regex.Replace(normalized, @"[^\w\s-]", "");
        slug = Regex.Replace(slug, @"\s+", "-");
        slug = Regex.Replace(slug, @"-+", "-").Trim('-');

        return $"heading-{index}-{slug}";
    }

    // Placeholder methods (scroll implementation uses JS interop in production)
    private async Task ScrollToHeading(string headingId) => await Task.Delay(50);
    private async Task ScrollToTop() => await Task.Delay(50);

    public void Dispose() { }

    /// <summary>Stores one extracted heading — its level, text, and anchor ID.</summary>
    private class HeadingInfo
    {
        /// <summary>Semantic heading level (2 = h2, 3 = h3).</summary>
        public int Level { get; set; }

        /// <summary>The plain text of the heading.</summary>
        public string? Text { get; set; }

        /// <summary>
        /// Generated anchor ID, e.g., "heading-0-introduction".
        /// Matches the id attribute on the target heading in the rendered HTML.
        /// </summary>
        public string? Id { get; set; }
    }
}
