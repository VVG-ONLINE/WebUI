@* ── Service injection ── *@
@inject VVG.Web.Services.ThemeService ThemeService

@* Theme toggle with sun (light mode) or moon (dark mode) icon *@
<button class="theme-toggle-btn" @onclick="ToggleTheme">
    @if (currentThemeClass == "dark-theme")
    {
        @* Sun icon = clicking will switch to light theme *@
        <i class="bi bi-sun-fill"></i>
    }
    else
    {
        @* Moon icon = clicking will switch to dark theme *@
        <i class="bi bi-moon-fill"></i>
    }
</button>

@code {
    private string currentThemeClass = "light-theme";

    /// <summary>
    /// Reads the persisted theme from localStorage and subscribes to changes
    /// so the icon updates if another component toggles the theme.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        currentThemeClass = await ThemeService.GetCurrentThemeAsync();
        ThemeService.OnThemeChanged += OnThemeChangedHandler;
    }

    /// <summary>Delegates the toggle to ThemeService which handles the localStorage write.</summary>
    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    /// <summary>
    /// When ThemeService fires OnThemeChanged (after a toggle), update the icon.
    /// Uses InvokeAsync because ThemeService might fire from a non-UI thread.
    /// </summary>
    private void OnThemeChangedHandler()
    {
        InvokeAsync(async () =>
        {
            currentThemeClass = await ThemeService.GetCurrentThemeAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChangedHandler;
    }
}
