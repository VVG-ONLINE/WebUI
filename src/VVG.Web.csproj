<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>
  <PropertyGroup>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MetaTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit.web" Version="1.28.9" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="bunit" Version="1.26.64" />
    <PackageReference Include="SpawnDev.BlazorJS.TransformersJS" Version="1.17.0" />
    <PackageReference Include="xunit" Version="2.8.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Watch Include="wwwroot\assets\css\**\*.scss" />
  </ItemGroup>


  <!-- Pre-build: compile SCSS into CSS -->
  <Target Name="CompileScss" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' != 'Release'">
    <Exec Command="sass wwwroot/assets/css:wwwroot/assets/css" />
  </Target>

  <!--
    Post-build: remove compressed framework assets and manifest entries.
    The DevServer's gzip template substitution ({0} -> gzip) is buggy in .NET 10,
    returning 0 bytes instead of falling back to uncompressed.
  -->
  <Target Name="RemoveCompressedFrameworkAssets" AfterTargets="Build">
    <PropertyGroup>
      <_Script>$(MSBuildProjectDirectory)/../scripts/remove-compressed-endpoints.py</_Script>
    </PropertyGroup>
    <Exec Command='python3 "$(_Script)" "$(IntermediateOutputPath)" "$(OutputPath)"' />
  </Target>

</Project>
