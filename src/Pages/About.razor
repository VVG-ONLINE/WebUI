@page "/About"
@inject VVG.Web.Services.MetadataService MetadataService
@inject HttpClient Http
@using System.Text.Json

<PageTitle>About Us</PageTitle>

<HeroBanner Title="We are the architects of the digital future."
    Subtitle="Founded on the principle of relentless innovation, VVG ONLINE is more than a consultancy; we are your strategic partner in navigating the complexities of the digital age." Taguser="// Principle_Driven_Execution" Tagpath="// Human_Centric_Technology" />

<section class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2 class="display-6">Our Mission: Decode, Design, Deliver.</h2>
            <p class="opacity-75 mt-3">In a world saturated with data and fleeting trends, clarity is the scarcest resource. Our mission is to decode the complex digital landscape, design bespoke strategies that are both ambitious and achievable, and deliver transformative results that create lasting value.</p>
            <p class="opacity-75">We don't just advise; we build. We embed ourselves with your teams, share our knowledge, and build capabilities that empower your organization to thrive long after our engagement ends.</p>
        </div>
        <div class="col-md-6 text-center">
            <img src="https://raw.githubusercontent.com/vvgonline/vvgonline/d6ce91fa38831bf3009b2070a2c9a0f323faa8f8/public/logo-2025.svg" alt="VVG ONLINE Mission" class="w-75 opacity-25" />
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container text-center">
        <div class="mb-5">
            <div class="terminal-tag-group justify-content-center">
                <div class="tag-segment tag-user">// Principle_Driven_Execution</div>
                <div class="tag-segment tag-path">// Human_Centric_Technology</div>
            </div>
            <h2 class="display-5">Our Philosophy</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h4 class="serif mb-3">1. Strategic Foresight</h4>
                    <p class="small opacity-75 mb-0">We operate with a view of the future, ensuring the solutions we build today are robust enough for the challenges of tomorrow. We prioritize long-term sustainability over short-term gains.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h4 class="serif mb-3">2. Radical Transparency</h4>
                    <p class="small opacity-75 mb-0">Our process is an open book. We provide clear, honest communication and full visibility into our methodologies, progress, and results. Trust is our most important metric.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h4 class="serif mb-3">3. Integrated Partnership</h4>
                    <p class="small opacity-75 mb-0">We are not vendors; we are partners. We succeed when you succeed. This means deeply integrating with your team and aligning our goals with your business objectives.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5" id="faq-section">
    <div class="container">
        <div class="text-center mb-5">
            <div class="terminal-tag-group justify-content-center">
                <div class="tag-segment tag-user">// Frequently_Asked</div>
                <div class="tag-segment tag-path">// Questions</div>
            </div>
            <h2 class="display-5">Frequently Asked Questions</h2>
            <p class="lead opacity-75 mt-3">Everything you need to know about VVG ONLINE and our services.</p>
        </div>

        @if (faqData != null && faqData.Faqs != null)
        {
            <div class="mb-4 text-center" id="faq-categories">
                <div class="d-flex flex-wrap justify-content-center gap-2" role="group" aria-label="FAQ Categories">
                    <button type="button" class="btn @(selectedCategory == "All" ? "btn-vvg" : "btn-outline-secondary")" @onclick="@(() => FilterByCategory("All"))">All</button>
                    @foreach (var category in faqData.Categories ?? new List<string>())
                    {
                        var cat = category;
                        <button type="button" class="btn @(selectedCategory == cat ? "btn-vvg" : "btn-outline-secondary")" @onclick="@(() => FilterByCategory(cat))">@cat</button>
                    }
                </div>
            </div>

            <div class="accordion" id="faqAccordion">
                @foreach (var faq in GetFilteredFaqs())
                {
                    <div class="accordion-item mb-3">
                        <h3 class="accordion-header" id="heading@(faq.Id)">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(faq.Id)" aria-expanded="false" aria-controls="collapse@(faq.Id)">
                                <strong>@faq.Question</strong>
                            </button>
                        </h3>
                        <div id="collapse@(faq.Id)" class="accordion-collapse collapse" aria-labelledby="heading@(faq.Id)" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                <p class="mb-2">@faq.Answer</p>
                                <small class="text-muted"><span class="badge bg-secondary">@faq.Category</span></small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading FAQs...</span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center" role="alert">
                FAQs are currently unavailable. Please check back later.
            </div>
        }
    </div>
</section>

<section class="container py-5">
    <div class="text-center">
        <h2 class="display-4">Ready to Build What's Next?</h2>
        <p class="lead opacity-75 mt-3">Let's start a conversation about your vision and how we can help you bring it to life.</p>
        <NavLink href="Contact" class="btn btn-vvg btn-lg text-center mt-4">Engage With Us</NavLink>
    </div>
</section>


@code {
    private FaqData? faqData;
    private string selectedCategory = "All";
    private bool isLoading = true;

    public class FaqData
    {
        public List<Faq>? Faqs { get; set; }
        public List<string>? Categories { get; set; }
    }

    public class Faq
    {
        public int Id { get; set; }
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await MetadataService.SetPageMetadata(new PageMetadata
        {
            Title = "About VVG ONLINE",
            Description = "Learn about VVG ONLINE's mission, philosophy, and our commitment to driving digital transformation and innovation.",
            Keywords = "about us, digital consulting, innovation, strategy, technology consulting",
            Image = "https://test.vvgonline.net/assets/images/twitter-cards/vvg-online-about-twitter-card.png",
            OgType = "website",
            OgTitle = "About VVG ONLINE",
            OgDescription = "We are a strategic partner in navigating the complexities of the digital age. Learn more about our mission and philosophy.",
            OgImage = "https://test.vvgonline.net/assets/images/twitter-cards/vvg-online-about-twitter-card.png",
            OgUrl = "https://test.vvgonline.net/About",

            TwitterCard = "summary_large_image",
            TwitterSite = "@vvgonlinedotnet",
            TwitterCreator = "@vvgonlinedotnet",
            TwitterTitle = "About VVG ONLINE",
            TwitterDescription = "Learn about our mission to decode the complex digital landscape, design bespoke strategies, and deliver transformative results.",
            TwitterImage = "https://test.vvgonline.net/assets/images/twitter-cards/vvg-online-about-twitter-card.png"
        });

        await LoadFaqData();
    }

    private async Task LoadFaqData()
    {
        try
        {
            isLoading = true;
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };
            faqData = await Http.GetFromJsonAsync<FaqData>("data/faq.json", options);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading FAQ data: {ex.Message}");
            faqData = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
    }

    private IEnumerable<Faq> GetFilteredFaqs()
    {
        if (faqData?.Faqs == null)
            return Enumerable.Empty<Faq>();

        if (selectedCategory == "All")
            return faqData.Faqs;

        return faqData.Faqs.Where(f => f.Category == selectedCategory);
    }
}