@* ============================================================
    PRICING PAGE — VVG ONLINE pricing plans and packages
    - Loads pricing data from assets/data/pricing.json
    - Shows service-level pricing, tiered packages, and custom bundles
    - Follows the same terminal-aesthetic pattern as Services.razor
    ============================================================ *@

@page "/pricing"
@using System.Net.Http.Json
@inject HttpClient Http
@inject MetadataService MetadataService

<PageTitle>Pricing</PageTitle>

<HeroBanner Title="Transparent Pricing, Real Value"
    Subtitle="Flexible plans and packages designed to fit every stage of your business growth. No hidden fees, no surprises."
    TagUser="// TRANSPARENT_PRICING" TagPath="// REAL_VALUE" />

@* -- SECTION 1: TIERED PACKAGES -- *@
<section class="vvg-pricing py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2>Choose Your Plan</h2>
            <p class="opacity-75">Monthly retainer packages for ongoing partnership</p>
            <div class="d-flex justify-content-center mt-4">
                <div class="billing-toggle-container p-1 d-inline-flex align-items-center">
                    <button type="button"
                            class="billing-toggle-btn @(!isYearly ? "active" : "")"
                            @onclick="() => SetYearly(false)">
                        Monthly
                    </button>
                    <button type="button"
                            class="billing-toggle-btn @(isYearly ? "active" : "")"
                            @onclick="() => SetYearly(true)">
                        <span>Yearly</span>
                        <span class="badge badge-accent-glow ms-2">SAVE 2 MONTHS</span>
                    </button>
                </div>
            </div>
        </div>

        @if (packages is null && errorMessage is null)
        {
            <p class="text-center">Loading...</p>
        }
        else if (errorMessage is not null)
        {
            <div class="alert alert-danger text-center">@errorMessage</div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var pkg in packages!)
                {
                    <div class="col-md-6 d-flex">
                        <div class="vvg-card p-4 d-flex flex-column w-100 @(pkg.popular ? "featured" : "")">
                            <h3 class="d-flex align-items-center gap-4 h5">
                                @pkg.name
                                @if (!string.IsNullOrEmpty(pkg.tag))
                                {
                                    <span class="badge badge-warning bg-accent text-dark">@pkg.tag</span>
                                }
                                @* @if (pkg.popular)
                                {
                                    <span class="badge badge-warning bg-accent text-dark">Most Popular</span>
                                } *@
                            </h3>
                            <p class="mono">@pkg.tagline</p>
                            @if (pkg.returns != null && pkg.returns.Length > 0)
                            {
                                <div class="d-flex gap-2 my-3">
                                    @foreach (var r in pkg.returns)
                                    {
                                        <div class="return-metric flex-fill text-center px-2 py-1">
                                            <span class="d-block return-value">@r.value</span>
                                            <span class="d-block return-label">@r.metric</span>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="h1">
                                @($"{GetSymbol()}{((isYearly ? pkg.yearlyPrice : pkg.price) ?? 0):N0}")
                                <span class="fs-6">/@(isYearly ? "year" : pkg.unit)</span>
                            </div>
                            @if (isYearly && pkg.oneTimeFeatures != null && pkg.oneTimeFeatures.Length > 0)
                            {
                                <p class="mono fs-6 mt-3 mb-1">▸ ONE-TIME SETUP</p>
                                <ul class="list-unstyled small">
                                    @foreach (var feature in pkg.oneTimeFeatures)
                                    {
                                        <li class="mb-1">✓ @feature</li>
                                    }
                                </ul>
                                <hr class="opacity-25 my-2" />
                            }
                            @if (isYearly && !string.IsNullOrEmpty(pkg.termsAndConditions))
                            {
                                <div class="small mono opacity-50 mt-2 mb-1">
                                    <i class="bi bi-info-circle me-1"></i>@pkg.termsAndConditions
                                </div>
                            }
                            @if (pkg.features != null && pkg.features.Length > 0)
                            {
                                <p class="mono fs-6 mt-2 mb-1">▸ MONTHLY SERVICES</p>
                                <ul class="list-unstyled">
                                    @foreach (var feature in pkg.features)
                                    {
                                        <li>✓ @feature</li>
                                    }
                                </ul>
                            }
                            <button class="btn btn-outline-secondary w-100 mt-auto">GET STARTED</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* -- SECTION 2: SERVICE-LEVEL PRICING -- *@
<section class="container py-5 border-top">
    <div class="text-center mb-5">
        <h2>Service Pricing</h2>
        <p class="opacity-75">Per-service pricing across all our solution areas</p>
    </div>

    @if (services is null)
    {
        <p class="text-center">Loading...</p>
    }
    else
    {
        <div class="row g-0 border-top border-start">
            @foreach (var (svc, index) in services.Select((value, i) => (value, i)))
            {
                <div class="col-md-6 col-lg-6 p-3 border-bottom border-end">
                    <span class="mono">0@(index + 1).</span>
                    <h3 class="mt-3">@svc.title</h3>
                    <p class="opacity-75 small">@svc.description</p>

                    @if (svc.pricingModels != null && svc.pricingModels.Length > 0)
                    {
                        <div class="mt-2 mb-3">
                            @foreach (var model in svc.pricingModels)
                            {
                                <div class="d-flex justify-content-between small border-bottom border-opacity-10 py-1">
                                    <span class="opacity-75">@model.label</span>
                                     <span class="mono ms-2 opacity-75">Starting from @($"{GetSymbol()}{(model.startingPrice ?? 0):N0}")</span>

                                    @if (model.features != null)
                                    {
                                        <div class="small mt-1">
                                            @string.Join(", ", model.features)
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(svc.ctaMessage))
                    {
                        <div class="small mono opacity-75 mt-2 mb-3">@svc.ctaMessage</div>
                    }

                    @if (svc.subservices != null && svc.subservices.Length > 0)
                    {
                        <details class="mt-2">
                            <summary class="small mono opacity-75">Sub-services</summary>
                            <ul class="list-unstyled mt-2">
                                @foreach (var sub in svc.subservices)
                                 {
                                     <li class="mb-1 small d-flex justify-content-between">
                                         <span>@sub.name</span>
                                         <span class="mono ms-2 opacity-75">Starting from @($"{GetSymbol()}{(sub.startingPrice ?? 0):N0}")/@sub.unit</span>
                                     </li>
                                 }

                            </ul>
                        </details>
                    }
                </div>
            }
        </div>
    }
</section>

@* -- SECTION 3: FREQUENTLY ASKED QUESTIONS -- *@
<section class="container py-5 border-top">
    <div class="text-center mb-5">
        <div class="terminal-tag-group justify-content-center">
            <div class="tag-segment tag-user">// Frequently_Asked</div>
            <div class="tag-segment tag-path">// Questions</div>
        </div>
        <h2 class="display-5">Frequently Asked Questions</h2>
        <p class="lead opacity-75 mt-3">Find answers to common questions about our pricing and services.</p>
    </div>

    @if (faqs != null && faqs.Count > 0)
    {
        @* Category filter buttons *@
        <div class="mb-4 text-center" id="faq-categories">
            <div class="d-flex flex-wrap justify-content-center gap-2" role="group" aria-label="FAQ Categories">
                <button type="button" class="btn btn btn-outline-secondary" @onclick="@(() => FilterByCategory("All"))">All</button>
                @foreach (var cat in faqCategories ?? new List<string>())
                {
                    var category = cat;
                    <button type="button" class="btn @(selectedCategory == category ? "btn btn-outline-secondary" : "btn-outline-secondary")" @onclick="@(() => FilterByCategory(category))">@category</button>
                }
            </div>
        </div>

        @* Bootstrap accordion *@
        <div class="accordion" id="faqAccordion">
            @foreach (var (faq, index) in GetFilteredFaqs().Select((value, i) => (value, i)))
            {
                var collapseId = $"collapsePricing{faq.Id}";
                var headingId = $"headingPricing{faq.Id}";
                <div class="accordion-item mb-3">
                    <h3 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <strong>@faq.Question</strong>
                        </button>
                    </h3>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#faqAccordion">
                                 <div class="accordion-body">
                                     <p class="mb-2">@((MarkupString)faq.Answer)</p>
                                     <small class="text-muted"><span class="badge bg-secondary">@faq.Category</span></small>
                                 </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading FAQs...</span>
            </div>
        </div>
    }
    else
    {
        <p class="text-center">Loading FAQs...</p>
    }
</section>

@* -- FOOTER NOTE -- *@
<section class="container py-4 border-top">
    <div class="text-center small">
    <div class="opacity-75">
        <i class="bi bi-info-circle me-1"></i>
        @(meta?.note != null ? meta.note : "All prices are indicative. Contact us for a custom quote tailored to your specific needs.")
    </div>
        <a href="/contact" class="btn bg-dark text-accent opacity-75">Get a free consultation</a>
    </div>
</section>

@code {
    // ===== TYPE DEFINITIONS =====

    class PricingDoc
    {
        public PricingMeta? meta { get; set; }
        public ServicePricing[]? servicePricing { get; set; }
        public TieredPackage[]? tieredPackages { get; set; }
    }

    class PricingMeta
    {
        public string? currency { get; set; }
        public string? currencySymbol { get; set; }
        public string? note { get; set; }
    }

    class ServicePricing
    {
        public int serviceId { get; set; }
        public string? title { get; set; }
        public string? description { get; set; }
        public string? ctaMessage { get; set; }
        public PricingModel[]? pricingModels { get; set; }
        public SubServicePricing[]? subservices { get; set; }
    }

    class PricingModel
    {
        public string? type { get; set; }
        public string? label { get; set; }
        public PriceRange? range { get; set; }
        public int? startingPrice { get; set; }
        public string[]? features { get; set; }
    }

    class PriceRange
    {
        public int min { get; set; }
        public int max { get; set; }
    }

    class SubServicePricing
    {
        public string? name { get; set; }
        public PriceRange? range { get; set; }
        public int? startingPrice { get; set; }
        public string? unit { get; set; }
    }

    class ReturnMetric
    {
        public string? metric { get; set; }
        public string? value { get; set; }
    }

    class TieredPackage
    {
        public string? id { get; set; }
        public string? name { get; set; }
        public string? tagline { get; set; }
        public ReturnMetric[]? returns { get; set; }
        public int price { get; set; }
        public int? yearlyPrice { get; set; }
        public string? unit { get; set; }
        public bool popular { get; set; }
        public string? tag { get; set; }
        public string? note { get; set; }
        public string? termsAndConditions { get; set; }
        public string[]? oneTimeFeatures { get; set; }
        public string[]? features { get; set; }
    }

    // ===== STATE =====

    PricingMeta? meta;
    ServicePricing[]? services;
    TieredPackage[]? packages;
    bool isYearly = false;
    string? errorMessage;

    string GetSymbol() => meta?.currencySymbol ?? "₹";

    private List<FlatFaqItem>? faqs;
    private bool isLoading = true;
    private string selectedCategory = "All";
    private List<string>? faqCategories;

    private List<FlatFaqItem> GetFilteredFaqs()
    {
        if (faqs == null) return new();
        if (selectedCategory == "All") return faqs;
        return faqs.Where(f => f.Category == selectedCategory).ToList();
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
    }

    private async Task LoadFaqs()
    {
        try
        {
            isLoading = true;
            var faqData = await Http.GetFromJsonAsync<List<FaqCategory>>("assets/data/json/pricing-faq.json");
            if (faqData != null)
            {
                var idCounter = 1;
                faqs = new List<FlatFaqItem>();
                faqCategories = new List<string>();
                foreach (var category in faqData)
                {
                    faqCategories.Add(category.Category);
                    foreach (var item in category.Questions)
                    {
                        faqs.Add(new FlatFaqItem
                        {
                            Id = idCounter++,
                            Question = item.Question,
                            Answer = item.Answer,
                            Category = category.Category
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pricing.razor: Error fetching FAQs - {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private class FaqCategory
    {
        public string Category { get; set; } = string.Empty;
        public List<FaqItem> Questions { get; set; } = new();
    }

    private class FaqItem
    {
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
    }

    private class FlatFaqItem
    {
        public int Id { get; set; }
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var pageMeta = await MetadataService.GetPageMetadataAsync("pricing");
        var pricingJsonLd = await MetadataService.GetPageJsonLdAsync("pricing");
        pageMeta.JsonLd = pricingJsonLd;
        await MetadataService.SetPageMetadata(pageMeta);

        try
        {
            var doc = await Http.GetFromJsonAsync<PricingDoc>("assets/data/json/pricing.json");
            if (doc is not null)
            {
                meta = doc.meta;
                services = doc.servicePricing;
                packages = doc.tieredPackages;
                await LoadFaqs();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load pricing data. Please try again later or contact support.";
            Console.WriteLine($"Pricing.razor: Error fetching pricing data - {ex.Message}");
        }
    }


    private void SetYearly(bool yearly)
    {
        isYearly = yearly;
    }

    private void ToggleYearly()
    {
        isYearly = !isYearly;
    }
}
