@* ==============================================================================
     MainLayout.razor — the SHELL that wraps every page
     Every page (Home, Blog, About, etc.) is rendered inside this layout.
     It provides: system panel nav bar, hero AI terminal, and footer.
     ============================================================================== *@

@inherits LayoutComponentBase
@namespace VVG.Web.Layout

<CascadingValue Value="this" IsFixed="true">

    <MetaTags />

    <div tabindex="0">

        <SystemPanel />

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>

        <div id="canvas-container"></div>
    </div>
</CascadingValue>

<SiteFooter />
